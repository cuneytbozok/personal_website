---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import MobileMenu from './MobileMenu.astro';
import SocialRail from './SocialRail.astro';
import Footer from './Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <a href="#content" class="skip-to-content">Skip to Content</a>

  <div class="bg-field"></div>
  <div class="bg-grid"></div>

  <!-- Scrolling past this marker gives the nav its solid "scrolled" style. -->
  <div class="nav-sentinel" id="navSentinel" aria-hidden="true"></div>
  <Nav />
  <MobileMenu />
  <SocialRail />

  <main id="content" tabindex="-1">
    <slot />
  </main>

  <Footer />
</BaseLayout>

<script>
  (function () {
    'use strict';

    /* ---------- orbit connectors: keep the dashed lines attached to each
       node's dot at any viewport size (node chips don't scale with the
       graphic, so the endpoints must be measured, not hard-coded) ---------- */
    function initOrbit() {
      var orbit = document.querySelector('.orbit');
      var svg = orbit && orbit.querySelector('.orbit-dots');
      if (!orbit || !svg) return;
      var paths = svg.querySelectorAll('path');
      // Each node maps to a path and the corner its dot sits on.
      var nodes = [
        ['n1', function (r) { return [r.right, r.bottom]; }],
        ['n2', function (r) { return [r.left, r.bottom]; }],
        ['n3', function (r) { return [r.right, r.top + r.height / 2]; }],
        ['n4', function (r) { return [r.left, r.top + r.height / 2]; }],
        ['n5', function (r) { return [r.right, r.top]; }],
        ['n6', function (r) { return [r.left, r.top]; }],
      ];
      var draw = function () {
        var o = orbit.getBoundingClientRect();
        if (!o.width || !o.height) return;
        nodes.forEach(function (n, i) {
          var el = orbit.querySelector('.orbit-node.' + n[0]);
          if (!el || !paths[i]) return;
          var p = n[1](el.getBoundingClientRect());
          var x = ((p[0] - o.left) / o.width) * 460;
          var y = ((p[1] - o.top) / o.height) * 460;
          paths[i].setAttribute('d', 'M' + x.toFixed(1) + ' ' + y.toFixed(1) + ' L230 230');
        });
      };
      // Redraw whenever the graphic changes size (also fires once on observe),
      // and once fonts settle, since chip widths depend on them.
      new ResizeObserver(draw).observe(orbit);
      window.addEventListener('load', draw);
      if (document.fonts && document.fonts.ready) { document.fonts.ready.then(draw); }
    }

    /* ---------- nav "scrolled" state: observe a 24px marker at the top
       of the page instead of listening to every scroll event ---------- */
    function initNavState() {
      var nav = document.getElementById('nav');
      var sentinel = document.getElementById('navSentinel');
      if (!nav || !sentinel) return;
      new IntersectionObserver(function (entries) {
        nav.classList.toggle('scrolled', !entries[0].isIntersecting);
      }).observe(sentinel);
    }

    /* ---------- scrollspy: highlight the nav link of the section in view.
       Where CSS can track it natively (scroll-target-group + :target-current)
       the browser handles the visuals and we only mirror aria-current.
       Elsewhere an IntersectionObserver drives both. ---------- */
    function initScrollspy() {
      var links = Array.prototype.slice.call(document.querySelectorAll('.nav-links a'));
      if (!links.length) return;
      var setCurrent = function (activeLink) {
        links.forEach(function (a) {
          var isActive = a === activeLink;
          a.classList.toggle('active', isActive);
          if (isActive) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      };

      if (CSS.supports('scroll-target-group: auto')) {
        var sync = function () {
          var current = null;
          links.forEach(function (a) { if (a.matches(':target-current')) current = a; });
          setCurrent(current);
        };
        window.addEventListener('scrollend', sync);
        window.addEventListener('load', sync);
        sync();
        return;
      }

      // Sections without a nav link (e.g. AssistMe) keep the previous link
      // highlighted; the hero, before any linked section, highlights none.
      var linkFor = {};
      links.forEach(function (a) { linkFor[a.getAttribute('data-sec')] = a; });
      var sections = Array.prototype.slice.call(document.querySelectorAll('main section[id]'));
      var owner = new Map();
      var last = null;
      sections.forEach(function (sec) {
        if (linkFor[sec.id]) last = linkFor[sec.id];
        owner.set(sec, last);
      });
      // A thin band 40% down the viewport: whichever section crosses it is current.
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) setCurrent(owner.get(e.target) || null);
        });
      }, { rootMargin: '-40% 0px -59% 0px' });
      sections.forEach(function (sec) { io.observe(sec); });
    }

    /* ---------- mobile menu: a modal <dialog>. The browser handles Escape,
       focus containment, inert background and focus return. ---------- */
    function initMobile() {
      var burger = document.getElementById('burger');
      var menu = document.getElementById('mobileMenu');
      var close = document.getElementById('mobileMenuClose');
      if (!burger || !menu || typeof menu.showModal !== 'function') return;
      burger.addEventListener('click', function () {
        menu.showModal();
        burger.setAttribute('aria-expanded', 'true');
      });
      menu.addEventListener('close', function () { burger.setAttribute('aria-expanded', 'false'); });
      if (close) close.addEventListener('click', function () { menu.close(); });
      menu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { menu.close(); });
      });
      // Close it if the viewport grows past the burger breakpoint.
      window.matchMedia('(min-width: 1101px)').addEventListener('change', function (e) {
        if (e.matches && menu.open) menu.close();
      });
    }

    /* ---------- count-up stats ----------
       The server-rendered HTML holds the real final value so crawlers and
       no-JS visitors see it. It is left untouched until the stat scrolls into
       view, so JS-rendering readers that never scroll still get real values. */
    function initCounters() {
      var nums = document.querySelectorAll('[data-count]');
      if (!nums.length) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var run = function (el) {
        var target = parseInt(el.getAttribute('data-count'), 10) || 0;
        var suffix = el.getAttribute('data-suffix') || '';
        if (reduce) { el.textContent = target + suffix; return; }
        var dur = 1400, start = null, done = false;
        var step = function (ts) {
          if (start === null) start = ts;
          var p = Math.min((ts - start) / dur, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(eased * target) + suffix;
          if (p < 1) requestAnimationFrame(step); else done = true;
        };
        requestAnimationFrame(step);
        setTimeout(function () { if (!done) el.textContent = target + suffix; }, 1600);
      };
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          run(e.target);
        });
      }, { rootMargin: '0px 0px -60px 0px' });
      nums.forEach(function (el) { io.observe(el); });
    }

    function init() {
      initOrbit();
      initNavState();
      initScrollspy();
      initMobile();
      initCounters();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else { init(); }
  })();
</script>
