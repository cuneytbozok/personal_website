---
/* Full years since the first ServiceNow role (Nov 2017), computed at build time. */
const careerStart = new Date(2017, 10, 1);
const now = new Date();
const yearsExperience =
  now.getFullYear() - careerStart.getFullYear() - (now.getMonth() < careerStart.getMonth() ? 1 : 0);

const stats = [
  {
    tone: 'violet',
    count: yearsExperience,
    suffix: '+',
    label: 'Years Experience',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>',
  },
  {
    tone: 'teal',
    count: 50,
    suffix: '+',
    label: 'Projects Delivered',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>',
  },
  {
    tone: 'amber',
    count: 20,
    suffix: '+',
    label: 'Integrations & APIs',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-5"/><path d="M9 8V2M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8z"/></svg>',
  },
  {
    tone: 'rose',
    count: 9,
    suffix: '',
    label: 'Industries',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4M10 10h4M10 14h4M10 18h4"/></svg>',
  },
];
---

<section class="section" id="about">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="num">01.</span>
      <h2>About Me</h2>
      <span class="rule"></span>
    </div>
    <div class="about-grid">
      <div class="card about-lead reveal">
        <div class="about-intro">
          <h3>Strategy. Architecture. Impact.</h3>
          <p class="entity-lead">I'm a Lead ServiceNow Developer at EPAM Systems, based in Istanbul, Türkiye, working across solution architecture, client discovery, and pre-sales. Since 2017 I've delivered ITSM, CSM/SOM, ITOM, CMDB/CSDM, Virtual Agent, API integrations, and AI enablement with Now Assist and Agentic AI.</p>
        </div>
        <div class="about-body">
          <p>I help enterprises turn business needs into practical technology decisions, solution architectures, and phased transformation roadmaps. I work with business and technical stakeholders to assess current capabilities, identify improvement opportunities, and communicate recommendations, risks, and implementation priorities.</p>
          <p>Hands-on delivery experience keeps my recommendations practical. It helps me evaluate platform constraints, integration dependencies, data quality, and the trade-offs between standard capabilities and customization. I use that experience to help stakeholders make informed technology decisions and give engineering teams clear direction.</p>
          <p>I also run internal ServiceNow trainings, facilitate architecture workshops with integrators and vendors, and take part in senior-level technical interviews.</p>
        </div>
      </div>
      <div class="stats">
        {stats.map((s, i) => (
          <div class={`card stat ${s.tone} reveal`} data-d={i + 1}>
            <span class="ic" set:html={s.icon} />
            <span class="meta">
              <span class="val" data-count={s.count} data-suffix={s.suffix}>{s.count}{s.suffix}</span>
              <span class="lbl">{s.label}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
