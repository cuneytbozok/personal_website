---
const repoUrl = 'https://github.com/cuneytbozok/assistme';

const points = [
  {
    title: 'Read-only.',
    text: "It can't create, change or delete anything, or run scripts.",
  },
  {
    title: 'You approve access.',
    text: 'Your AI assistant shows a code, and nothing is read until you approve it in Chrome.',
  },
  {
    title: 'Your credentials stay put.',
    text: 'Your AI assistant never sees your password, cookies or session tokens.',
  },
  {
    title: 'Tested to prove it.',
    text: '30,000 fuzzed tool calls, and every one was a GET.',
  },
];
---

<section class="section" id="assistme">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2>Something I Built</h2>
      <span class="rule"></span>
    </div>
    <div class="card spotlight reveal">
      <div class="spotlight-media">
        <video
          id="assistmeVideo"
          controls
          playsinline
          preload="none"
          width="1920"
          height="1080"
          poster="/images/assistme-poster.jpg"
          aria-label="AssistMe intro video, 23 seconds"
        >
          <source src="/videos/assistme-intro.mp4" type="video/mp4" />
          <a href="/videos/assistme-intro.mp4">Download the AssistMe intro video</a>
        </video>
        <button class="spotlight-play" id="assistmePlay" type="button" aria-label="Play the AssistMe intro video, 23 seconds" hidden>
          <span class="pill">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5Z" /></svg>
            <span class="lbl">Watch · 0:23</span>
          </span>
        </button>
      </div>
      <div class="spotlight-body">
        <p class="tag">Independent open-source project · ServiceNow × AI</p>
        <h3>AssistMe</h3>
        <p class="line">Your AI reads your ServiceNow. You stay in control.</p>
        <p class="desc">
          AI assistants are good at investigating a ServiceNow instance, but most teams
          can't hand one credentials or write access. I built this connector so Claude,
          ChatGPT Codex or Mistral Vibe can do it through your own Chrome session. Ask why an incident changed or
          which scripts touch a field, and it reads the answer with your permissions.
        </p>
        <a href={repoUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          View on GitHub
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
        </a>
        <p class="note">Mac + Chrome · about 10 minutes to set up. Independent project, not affiliated with ServiceNow.</p>
      </div>
      <ul class="spotlight-points">
        {points.map((p) => (
          <li>
            <strong><span class="ck" aria-hidden="true">✓</span> {p.title}</strong>
            <span>{p.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  /* Native controls stay on without JS. With JS, a click anywhere on the
     poster starts playback, and the native controls return from then on. */
  const video = document.getElementById('assistmeVideo') as HTMLVideoElement | null;
  const play = document.getElementById('assistmePlay') as HTMLButtonElement | null;
  if (video && play) {
    video.controls = false;
    play.hidden = false;
    play.addEventListener('click', () => {
      play.hidden = true;
      video.controls = true;
      video.focus();
      video.play().catch(() => {});
    });
  }
</script>
