---
/* FAQ content is defined once and rendered both as visible HTML and as
   FAQPage JSON-LD, so the markup and schema can never drift apart. */
const faqs = [
  {
    q: 'Who is Cüneyt Bozok?',
    a: 'Cüneyt Bozok is a Lead ServiceNow Developer at EPAM Systems, based in Istanbul, Türkiye, with responsibilities spanning client discovery, solution architecture, maturity assessments, and pre-sales. He has been designing and delivering ServiceNow solutions since 2017 — from discovery and maturity assessment through target-state architecture, integrations, and rollout.',
  },
  {
    q: 'What kinds of consulting engagements does Cüneyt Bozok focus on?',
    a: 'Discovery workshops, ITSM and CMDB/CSDM maturity assessments, target-state architecture, fit-to-standard evaluation, phased transformation roadmaps, and pre-sales demos and proofs of concept, mostly around service management and AI enablement on ServiceNow.',
  },
  {
    q: 'How does his technical background support his advisory work?',
    a: 'He has built on ServiceNow since 2017: integrations, portals, Virtual Agent experiences, and custom applications. That delivery experience lets him judge integration dependencies, data quality, and platform constraints when recommending a target state, and hand over HLDs, ADRs, and API contracts that engineering teams can build from.',
  },
  {
    q: 'Which ServiceNow capabilities has he worked with?',
    a: 'ITSM, CSM and Service Order Management (SOM), ITOM, CMDB/CSDM data foundations, Virtual Agent, custom HR service portals, Flow Designer and IntegrationHub, and AI enablement with Now Assist and Agentic AI.',
  },
  {
    q: 'Which industries has he worked in?',
    a: 'Telecom, technology and networking, pharmaceuticals, e-commerce, manufacturing, banking and financial services, food and consumer goods, enterprise software, and wellness — across EPAM Systems, Softtech, and Deloitte engagements.',
  },
  {
    q: 'What certifications does Cüneyt Bozok hold?',
    a: 'ServiceNow Certified System Administrator (CSA), Certified Application Developer (CAD), Certified Implementation Specialist – ITSM, CIS – Data Foundations (CMDB & CSDM), ITSM Professional Suite, Now Assist for ITSM Pro Plus Suite, and Pre-Sales Core, plus micro-certifications including Agentic AI Executive, Now Assist Executive, Flow Designer, IntegrationHub, Virtual Agent, Service Portal, Performance Analytics, and Predictive Intelligence.',
  },
  {
    q: 'Is he open to new opportunities?',
    a: 'Yes. He is interested in technology consulting, service transformation, and solution architecture roles that connect business priorities with practical technology decisions and delivery.',
  },
  {
    q: 'How can I contact Cüneyt Bozok?',
    a: 'By email at cuneyt@cuneytbozok.com, or via LinkedIn at linkedin.com/in/cuneytbozok. His work is also on GitHub at github.com/cuneytbozok.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="section" id="faq">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="num">05.</span>
      <h2>Frequently Asked Questions</h2>
      <span class="rule"></span>
    </div>
    <div class="faq-grid">
      {faqs.map((f, i) => (
        <div class="card faq-item reveal" data-d={(i % 2) + 1}>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
