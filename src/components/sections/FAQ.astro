---
/* FAQ content is defined once and rendered both as visible HTML and as
   FAQPage JSON-LD, so the markup and schema can never drift apart. */
const faqs = [
  {
    q: 'Who is Cüneyt Bozok?',
    a: 'Cüneyt Bozok is a Lead ServiceNow Developer at EPAM Systems, based in Istanbul, Türkiye. His work spans technology consulting and solution architecture: client discovery, maturity assessments, target-state design, transformation roadmaps, and pre-sales. He has worked with ServiceNow since 2017, at Deloitte Turkey, Softtech, and EPAM Systems.',
  },
  {
    q: 'What kinds of consulting work does he focus on?',
    a: 'Discovery and stakeholder workshops, ITSM and CMDB/CSDM maturity assessments, business process improvement, fit-to-standard evaluation, target-state architecture, and phased transformation roadmaps. Most of this work is in service management and AI enablement on ServiceNow, and it often starts in pre-sales with demos and proofs of concept.',
  },
  {
    q: 'How does his technical background support his advisory work?',
    a: 'He has built on ServiceNow since 2017 across ITSM, CSM and Service Order Management (SOM), ITOM, CMDB/CSDM, Virtual Agent, service portals, Flow Designer and IntegrationHub, and Now Assist and Agentic AI. That delivery experience lets him weigh platform constraints, integration dependencies, and data quality when recommending a target state, and give engineering teams direction they can build from.',
  },
  {
    q: 'Which industries has he worked in?',
    a: 'Telecom, technology and networking, pharmaceuticals, e-commerce, manufacturing, banking and financial services, food and consumer goods, enterprise software, and wellness — across EPAM Systems, Softtech, and Deloitte engagements.',
  },
  {
    q: 'What certifications does Cüneyt Bozok hold?',
    a: 'ServiceNow Certified System Administrator (CSA), Certified Application Developer (CAD), Certified Implementation Specialist – ITSM, CIS – Data Foundations (CMDB & CSDM), ITSM Professional Suite, Now Assist for ITSM Pro Plus Suite, and Pre-Sales Core, plus micro-certifications including Agentic AI Executive, Now Assist Executive, Flow Designer, IntegrationHub, Virtual Agent, Service Portal, Performance Analytics, and Predictive Intelligence.',
  },
  {
    q: 'What is AssistMe?',
    a: 'AssistMe is his open-source side project. It lets AI assistants such as Claude, ChatGPT Desktop, and Mistral Vibe investigate a ServiceNow instance through the user\'s existing Chrome session, with read-only tools, the user\'s own permissions, and access approved in the browser. It is an early-stage project, so far tested on Mac with an admin account, and is available at github.com/cuneytbozok/assistme.',
  },
  {
    q: 'Is he open to new opportunities, and how can I reach him?',
    a: 'Yes. He is interested in opportunities around technology consulting, digital transformation, and advisory. Reach him by email at cuneyt@cuneytbozok.com or on LinkedIn at linkedin.com/in/cuneytbozok.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="section" id="faq">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="num">05.</span>
      <h2>Frequently Asked Questions</h2>
      <span class="rule"></span>
    </div>
    <div class="faq-list">
      {faqs.map((f, i) => (
        <details class="card faq-item reveal" open={i === 0}>
          <summary>
            <h3>{f.q}</h3>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
